---
import FeatureShowcase from "../react/FeatureShowcase";
---

<section class="py-24 bg-slate-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div
        class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full"
      >
        Our Services
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        <span
          class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600"
        >
          One-stop
        </span>
        Global Fulfillment Service
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Covers all order fulfillment links from front-end order management to
        the last-mile delivery
      </p>
    </div>

    <!-- <FeatureShowcase client:load /> -->
    <section class="mt-12">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 lg:gap-8 items-stretch"
      >
        <div class="flex flex-col items-center text-center">
          <img
            decoding="async"
            width="148"
            height="183"
            src="https://www.nextsmartship.com/wp-content/uploads/2024/10/Integrate_icon.png"
            alt="Integrate your store"
            class="mb-4 h-32 w-auto object-contain"
          />
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            Integrate<br />Your Store
          </h3>
          <p class="text-sm text-slate-600 max-w-xs">
            Link your store to import products automatically
          </p>
        </div>

        <div class="flex flex-col items-center text-center">
          <img
            loading="lazy"
            decoding="async"
            width="182"
            height="171"
            src="https://www.nextsmartship.com/wp-content/uploads/2024/10/Inventory-icon.png"
            alt="Send your inventory"
            class="mb-4 h-32 w-auto object-contain"
          />
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            Send Your<br />Inventory
          </h3>
          <p class="text-sm text-slate-600 max-w-xs">
            Send Your Inventory to Our Warehouse
          </p>
        </div>

        <div class="flex flex-col items-center text-center">
          <img
            loading="lazy"
            decoding="async"
            width="191"
            height="155"
            src="https://www.nextsmartship.com/wp-content/uploads/2024/10/Receive-icon.png"
            alt="Receive orders"
            class="mb-4 h-32 w-auto object-contain"
          />
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            Receive<br />Orders
          </h3>
          <p class="text-sm text-slate-600 max-w-xs">
            Receive Orders(All customer orders are automatically synchronized with our fulfillment system.)
          </p>
        </div>

        <div class="flex flex-col items-center text-center">
          <img
            loading="lazy"
            decoding="async"
            width="204"
            height="154"
            src="https://www.nextsmartship.com/wp-content/uploads/2024/10/Shiporder_icon.png"
            alt="Ship orders"
            class="mb-4 h-32 w-auto object-contain"
          />
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            Ship<br />Orders
          </h3>
          <p class="text-sm text-slate-600 max-w-xs">
            Customers receive a tracking number via email as soon as their order ships.
          </p>
        </div>

        <div class="flex flex-col items-center text-center">
          <img
            loading="lazy"
            decoding="async"
            width="204"
            height="154"
            src="https://www.nextsmartship.com/wp-content/uploads/2024/10/Shiporder_icon.png"
            alt="Ship orders"
            class="mb-4 h-32 w-auto object-contain"
          />
          <h3 class="text-lg font-semibold text-slate-900 mb-2">
            Ship<br />Orders
          </h3>
          <p class="text-sm text-slate-600 max-w-xs">
            Order Shipping（We pick, pack and deliver your orders straight to your customers.）
          </p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a
        href="/capabilities"
        class="inline-flex items-center px-8 py-4 text-base font-semibold text-white bg-linear-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-lg shadow-lg hover:shadow-xl transition-all group"
      >
        Explore All Capabilities
        <svg
          class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
