---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import { Image } from 'astro:assets';

import heroBgImg from '@assets/sea-freight.jpeg';
import featureImg from '@assets/photo-1586528116311-ad8dd3c8310d.jpg';
---

<BaseLayout title="Sea Freight - Global-link">
  <!-- 1) 顶部图片背景 + 描述 -->
  <section class="relative h-[56vh] min-h-[420px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image src={heroBgImg} alt="Sea freight" class="w-full h-full object-cover object-top" />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/90 via-slate-900/70 to-slate-900/40"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight">
          Sea <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-300 to-teal-300">Freight</span>
        </h1>
        <h2 class="text-2xl md:text-3xl font-bold text-slate-200">Sea Freight(FCL - Full container load shipments / LCL - Consolidated shipments / Cargo Insurance / Trailer trucking / Cargo clearance)</h2>

        <p class="mt-6 text-lg md:text-xl text-slate-200 leading-relaxed max-w-3xl">
          Sea freight is a cost-effective way to move goods across global ports, ideal for large-volume, non-time-sensitive shipments.
        </p>
      </div>
    </div>
  </section>

  <!-- 2) 标题 + 图片 -->
  <Section background="gray">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
            Service highlights
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900">
            End-to-end sea freight coordination
          </h2>
          <p class="mt-5 text-lg text-slate-600 leading-relaxed">
            We manage the full process: booking, customs clearance, carrier coordination, and inland transportation. Freight costs depend on cargo size, weight, distance, and service type (FCL / LCL).
          </p>
          <ul class="mt-6 space-y-3 text-slate-700">
            <li class="flex gap-3">
              <span class="mt-2 w-2 h-2 rounded-full bg-blue-600 shrink-0"></span>
              <span><strong class="font-semibold">Best for</strong>: raw materials, machinery, vehicles, and consumer goods</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-2 w-2 h-2 rounded-full bg-teal-600 shrink-0"></span>
              <span><strong class="font-semibold">Service types</strong>: FCL (Full Container Load) and LCL (Less than Container Load)</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-2 w-2 h-2 rounded-full bg-blue-600 shrink-0"></span>
              <span><strong class="font-semibold">What we handle</strong>: booking, documentation, and carrier coordination</span>
            </li>
          </ul>
        </div>

        <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
          <div class="absolute inset-0 bg-linear-to-tr from-blue-600/10 via-transparent to-teal-600/10"></div>
          <Image src={featureImg} alt="Port and containers" class="w-full h-[420px] object-cover" />
        </div>
      </div>
    </div>
  </Section>

  <!-- 3) 众多文字描述 -->
  <Section background="white">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <!-- <h2 class="text-2xl md:text-3xl font-bold text-slate-900">服务说明</h2> -->

        <div class="mt-6 space-y-6 text-slate-600 leading-relaxed text-lg">
          <p>
            Sea freight is the cost-effective transportation of goods by cargo ships across global ports. It is ideal for large-volume, non-time-sensitive shipments over long distances, including raw materials, machinery, vehicles and consumer goods.
          </p>
          <p>
            We manage the full process: booking, customs clearance, carrier coordination and inland transportation. Freight costs depend on cargo size, weight, distance and service type (FCL / LCL).
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h3 class="text-base font-bold text-slate-900">Container Types</h3>
              <ul class="mt-4 space-y-2 text-slate-700">
                <li>20ft, 40ft &amp; 45ft standard containers</li>
                <li>40ft containers are the most common, holding 25–28 metric tons</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h3 class="text-base font-bold text-slate-900">Freight Rates</h3>
              <p class="mt-4 text-slate-700">
                Rates are based on cargo size, weight, route, service type and market conditions, and may fluctuate with fuel prices, capacity and seasonality.
              </p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h3 class="text-base font-bold text-slate-900">Documentation</h3>
              <p class="mt-4 text-slate-700">Proper documentation ensures smooth customs clearance:</p>
              <ul class="mt-3 space-y-2 text-slate-700">
                <li>Bills of lading</li>
                <li>Commercial invoices</li>
                <li>Packing lists</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h3 class="text-base font-bold text-slate-900">Main Sea Freight Services</h3>
              <ul class="mt-4 space-y-2 text-slate-700">
                <li><strong class="font-semibold">FCL (Full Container Load)</strong>: Exclusive use of a full container.</li>
                <li><strong class="font-semibold">LCL (Less than Container Load)</strong>: Shared container for smaller shipments.</li>
                <li><strong class="font-semibold">Ro-Ro</strong>: For vehicles and rolling equipment.</li>
                <li><strong class="font-semibold">Break Bulk</strong>: For oversized, non-containerized cargo.</li>
                <li><strong class="font-semibold">Project Cargo</strong>: For heavy, complex and special equipment.</li>
              </ul>
            </div>
          </div>

          <p class="pt-2">
            The service you choose depends on your cargo type, volume and delivery requirements.
          </p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

